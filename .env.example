RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Shadow Chart <onboarding@resend.dev>
OPENAI_API_KEY=sk_your_openai_key_here
OPENAI_MODEL=gpt-4.1-mini
# Optional: set true if you want generation to fail instead of using mock fallback.
# OPENAI_STRICT=true
# Optional locally: set true to test the flow without calling OpenAI.
# DISABLE_OPENAI_REPORT=true
# Optional locally: set true to generate reports without sending PDF emails.
# DISABLE_REPORT_EMAIL=true
PORT=4177
HOST=127.0.0.1
# Optional locally. Railway Postgres will provide DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required. Use sandbox or production. Do not omit this value.
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=test_your_client_side_token_here
PADDLE_API_KEY=pdl_sdbx_your_api_key_here
PADDLE_SNAPSHOT_PRICE_ID=pri_your_099_snapshot_price_id_here
PADDLE_FULL_REPORT_PRICE_ID=pri_your_full_report_price_id_here

# Set the default payment link in Paddle dashboard: Checkout > Checkout settings.
# Sandbox can use localhost for testing; live must use an approved real domain.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret_here
